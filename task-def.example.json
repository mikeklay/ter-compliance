{
  "taskDefinitionArn": "arn:aws:ecs:us-west-2:<ACCOUNT_ID>:task-definition/ter-compliance-task:4",
  "containerDefinitions": [
    {
      "name": "ter-compliance-container",
      "image": "<ACCOUNT_ID>.dkr.ecr.<REGION>.amazonaws.com/ter-compliance:latest",
      "cpu": 0,
      "portMappings": [
        {
          "containerPort": 5000,
          "hostPort": 5000,
          "protocol": "tcp",
          "name": "ter-compliance-container-5000-tcp"
        }
      ],
      "essential": true,
      "environment": [
        {
          "name": "AWS_REGION",
